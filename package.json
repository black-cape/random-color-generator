{
  "name": "@black-cape/random-color-generator",
  "version": "0.1.0",
  "author": "Black Cape, Inc.",
  "license": "MIT",
  "description": "Simple class for generating random colors",
  "type": "module",
  "main": "./dist/random-color-generator.umd.cjs",
  "module": "./dist/random-color-generator.js",
  "types": "./dist/random-color-generator.d.ts",
  "exports": {
    ".": {
      "types": "./dist/random-color-generator.d.ts",
      "import": "./dist/random-color-generator.js",
      "require": "./dist/random-color-generator.umd.cjs"
    }
  },
  "files": [
    "dist/"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "lint": "eslint --cache --cache-location ./node_modules/.cache/eslint --max-warnings 0 .",
    "prettier": "prettier --check .",
    "prettier:write": "prettier --write .",
    "test": "vitest",
    "typecheck": "tsc",
    "coverage": "vitest run --coverage"
  },
  "repository": {
    "type": "git",
    "url": "ssh://git@gitlab.blackcape.dev:2222/black-cape/random-color-generator.git"
  },
  "keywords": [
    "D3",
    "Color",
    "Random",
    "Typescript"
  ],
  "dependencies": {
    "d3-color": ">=3.1.0"
  },
  "devDependencies": {
    "@types/d3-color": "^3.1.3",
    "@types/node": "^24.10.1",
    "@vitest/coverage-v8": "^4.0.10",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.5.0",
    "prettier": "^3.6.2",
    "prettier-plugin-organize-imports": "^4.3.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.47.0",
    "vite": "^7.2.2",
    "vite-plugin-dts": "^4.5.4",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^4.0.10"
  },
  "prettier": {
    "plugins": [
      "prettier-plugin-organize-imports"
    ],
    "arrowParens": "always",
    "bracketSpacing": false,
    "printWidth": 120,
    "tabWidth": 2,
    "trailingComma": "none",
    "semi": true,
    "singleQuote": true
  }
}
